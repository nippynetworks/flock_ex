!_TAG_FILE_FORMAT	2	/extended format; --format=1 will not append ;" to lines/
!_TAG_FILE_SORTED	1	/0=unsorted, 1=sorted, 2=foldcase/
!_TAG_PROGRAM_AUTHOR	Darren Hiebert	/dhiebert@users.sourceforge.net/
!_TAG_PROGRAM_NAME	Exuberant Ctags	//
!_TAG_PROGRAM_URL	http://ctags.sourceforge.net	/official site/
!_TAG_PROGRAM_VERSION	5.8	//
CFLAGS	Makefile	/^CFLAGS = -fPIC -shared -I$(ERL_CFLAGS) -I$(ERTS_INCLUDE_DIR) -O2$/;"	m
ERL_CFLAGS	Makefile	/^ERL_CFLAGS := $(shell erl -noshell -eval 'io:format("~s\/include", [code:root_dir()])' -s init stop)$/;"	m
ERTS_INCLUDE_DIR	Makefile	/^ERTS_INCLUDE_DIR := $(shell erl -noshell -eval 'io:format("~s\/include", [code:lib_dir(erts)])' -s init stop)$/;"	m
LDFLAGS	Makefile	/^LDFLAGS =$/;"	m
NIF_NAME	Makefile	/^NIF_NAME = flock_ex$/;"	m
OUT	Makefile	/^OUT = priv\/$(NIF_NAME).so$/;"	m
SRC	Makefile	/^SRC = c_src\/$(NIF_NAME).c$/;"	m
